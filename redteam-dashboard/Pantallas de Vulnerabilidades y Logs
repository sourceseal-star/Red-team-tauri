# 2. Crear pantalla de Logs
cat << 'EOF' > lib/screens/logs_screen.dart
import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';

class LogsScreen extends StatelessWidget {
  const LogsScreen({super.key});

  final List<Map<String, String>> _logs = const [
    {'time': '14:27:59', 'level': 'CRITICAL', 'module': 'PINNING', 'msg': 'Backend no presenta certificado TLS válido'},
    {'time': '14:27:58', 'level': 'HIGH', 'module': 'SOURCESEAL', 'msg': 'A5: Validación de firma HMAC FALLÓ'},
    {'time': '14:27:58', 'level': 'HIGH', 'module': 'SOURCESEAL', 'msg': 'A6: Replay attack FALLÓ'},
    {'time': '14:27:59', 'level': 'HIGH', 'module': 'MULTIPLATFORM', 'msg': 'Sin uso del almacén seguro nativo (AndroidKeyStore)'},
    {'time': '14:28:05', 'level': 'INFO', 'module': 'SYSTEM', 'msg': 'Usuario inició sesión en SourceSeal Control Center'},
  ];

  Color _getColor(String level) {
    if (level == 'CRITICAL') return Colors.redAccent;
    if (level == 'HIGH') return Colors.orange;
    if (level == 'INFO') return Colors.blueAccent;
    return Colors.grey;
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Logs de Auditoría')),
      body: ListView.builder(
        padding: const EdgeInsets.all(16),
        itemCount: _logs.length,
        itemBuilder: (context, index) {
          final log = _logs[index];
          return Card(
            margin: const EdgeInsets.only(bottom: 8),
            child: ListTile(
              leading: CircleAvatar(
                backgroundColor: _getColor(log['level']!).withOpacity(0.2),
                child: Text(log['level']![0], style: TextStyle(color: _getColor(log['level']!), fontWeight: FontWeight.bold)),
              ),
              title: Text(log['msg']!, style: GoogleFonts.inter(fontSize: 14)),
              subtitle: Text('${log['module']} • ${log['time']}', style: const TextStyle(color: Colors.grey, fontSize: 12)),
            ),
          );
        },
      ),
    );
  }
}
EOF