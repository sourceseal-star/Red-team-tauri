            color: const Color(0xFF0D1117),
            padding: const EdgeInsets.all(12),
            child: TextField(
              controller: _codeController,
              maxLines: null,
              keyboardType: TextInputType.multiline,
              style: GoogleFonts.firaCode(color: Colors.greenAccent, fontSize: 14, height: 1.4),
