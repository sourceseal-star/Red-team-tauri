{
  "osiris_url": "http://localhost:3000/api",
  "seal_ws": "ws://localhost:8001/ws/alerts",
  "db_path": "~/connector_cache.db",
  "log_file": "~/connector.log",
  "log_level": "INFO",
  "max_retries": 5,
