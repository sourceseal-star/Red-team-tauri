        info "Comunicación satelital no está habilitada en la configuración"
        read -p "¿Habilitar comunicación satelital? (s/n, default: n): " choice
        if [ "${choice:-n}" != "s" ]; then
            return 0
        fi
        SATELLITE_ENABLED=true
        save_config
    fi

    info "Configurando dispositivo satelital..."

