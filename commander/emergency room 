$public_key"

            if [ ${#message} -gt $max_length ]; then
                # Enviar en múltiples SMS
                local parts=()
                while [ ${#message} -gt $max_length ]; do
                    parts+=("${message:0:$max_length}")
                    message="${message:$max_length}"
                done
                parts+=("$message")

                for part in "${parts[@]}"; do
                    send_sms "$contact_phone" "$part" "no_encrypt"
