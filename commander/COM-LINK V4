### 10.3 Filtros de Eventos

Para evitar saturar OSIRIS con eventos de baja prioridad:

```python
# En main_connector.py, añadir:

class EventFilter:
    """Filtro de eventos"""
    
    def __init__(self):
        self.blocked_types = []
        self.min_severity = "info"  # info, low, medium, high, critical
        self.rate_limit = {}  # type: (count, last_time)
        self.max_rate = 10  # Máximo 10 eventos por tipo por minuto
    
    def should_process(self, event_type: str, payload: dict) -> bool:
        """Determinar si se debe procesar el evento"""
        # Bloquear tipos específicos
        if event_type in self.blocked_types:
            return False
        
        # Filtrar por severidad
        severity = payload.get("severity", "info").lower()
        severity_levels = ["info", "low", "medium", "high", "critical"]
        
        if severity_levels.index(severity) < severity_levels.index(self.min_severity):
            return False
        
        # Rate limiting
        now = time.time()
        if event_type in self.rate_limit:
            count, last_time = self.rate_limit[event_type]
            if now - last_time < 60 and count >= self.max_rate:
                return False
            
            if now - last_time >= 60:
                count = 0
            
            self.rate_limit[event_type] = (count + 1, now)
        else:
            self.rate_limit[event_type] = (1, now)
        
        return True
    
    def block_type(self, event_type: str):
        """Bloquear un tipo de evento"""
        if event_type not in self.blocked_types:
            self.blocked_types.append(event_type)
    
    def unblock_type(self, event_type: str):
        """Desbloquear un tipo de evento"""
        if event_type in self.blocked_types:
            self.blocked_types.remove(event_type)
    
    def set_min_severity(self, severity: str):
        """Establecer severidad mínima"""
        self.min_severity = severity.lower()
```

