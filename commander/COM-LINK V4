    async def _check_all(self):
        """Verificar todos los componentes"""
        checks = []
        
        # Verificar OSIRIS
        osiris_healthy = await self.osiris_client.check_health()
        checks.append(("OSIRIS", "healthy" if osiris_healthy else "unhealthy"))
        
        # Verificar caché
