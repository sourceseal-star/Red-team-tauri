{
  "productName": "SourceSeal Console",
  "version": "0.1.0",
  "identifier": "com.sourceseal.console",
  "build": {
    "frontendDist": "../tauri-frontend/dist",
    "devUrl": "http://localhost:5000",
    "beforeDevCommand": "cd tauri-frontend && npm run dev",
    "beforeBuildCommand": "cd tauri-frontend && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SourceSeal Console",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
