# SealCtl - Variables de entorno
# API KEY obligatoria para acceder al servidor
REDTEAM_API_KEY=genera-una-clave-aleatoria-aqui

# Host binding (127.0.0.1 = solo localhost, 0.0.0.0 = todas las interfaces)
HOST=127.0.0.1
PORT=3000

# CORS origins permitidas (separadas por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Honeypot
HONEYPOT_PORT=8080

# ─── Termux Bridge ───────────────────────────────────────────────────────────
# URL pública del backend local corriendo en Termux (ej. túnel ngrok/cloudflared,
# o la IP local si Replit y Termux están en la misma red).
TERMUX_API_URL=http://127.0.0.1:8000
