# SourceSeal Console — Variables de entorno
#
# .env es la ÚNICA fuente de verdad para credenciales.
# El código NUNCA regenera ni sobrescribe un valor que ya existe aquí.
# Para definir tus claves: bash control_claves.sh set
# Para recuperarlas:      bash control_claves.sh restore

# ─── ACCESO AL DASHBOARD (:8001) ────────────────────────────────────────────
# El login web usa ADMIN_EMAIL + ADMIN_PASSWORD.
# REDTEAM_API_KEY es el token Bearer que el frontend usa después del login.
# Si dejas estos vacíos, control_claves.sh los generará por ti.
ADMIN_EMAIL=admin@redteam.local
ADMIN_PASSWORD=
REDTEAM_API_KEY=

# ─── NEXUS OMNI (:8004) ──────────────────────────────────────────────────────
# Acceso HTTP Basic al servicio Nexus Omni.
NEXUS_USER=admin
NEXUS_PASS=
NEXUS_PORT=8004

# ─── RED ────────────────────────────────────────────────────────────────────
# Host binding (0.0.0.0 = todas las interfaces, acceso desde WiFi)
HOST=0.0.0.0
PORT=8001

# CORS origins permitidas (separadas por comas)
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Honeypot
HONEYPOT_PORT=8080

# ─── API KEYS OSINT (todas tienen tier gratis) ──────────────────────────────
# AbuseIPDB (gratis, 1000 checks/día): https://www.abuseipdb.com/account/api
# IMPORTANTE: usar ABUSEIPDB_KEY (no ABUSEIPDB_API_KEY)
ABUSEIPDB_KEY=

# Shodan (gratis, cuenta básica): https://www.shodan.io/dashboard
SHODAN_API_KEY=

# Hunter.io (opcional, emails): https://hunter.io/api-keys
HUNTER_API_KEY=

# VirusTotal (gratis, 4 req/min): https://www.virustotal.com/api
VIRUSTOTAL_API_KEY=

# Censys (gratis, 25 req/día): https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# Google Custom Search (gratis, 100 req/día): https://console.cloud.google.com
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# GitHub recon (gratis): https://github.com/settings/tokens (scope: read:user)
GITHUB_TOKEN=

# ─── Telegram (alertas del dashboard :8001 y notificaciones criticas) ──────
# Crea el bot con @BotFather en Telegram, copia el token.
# CHAT_ID: escribele al bot y visita https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── SMTP (Commander — envio de reportes por correo) ────────────────────────
# Usar contraseña de aplicacion de Gmail (no la contraseña normal de la cuenta):
# https://myaccount.google.com/apppasswords
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=

# ─── Termux Bridge ───────────────────────────────────────────────────────────
TERMUX_API_URL=http://127.0.0.1:8000


# ─── NEXUS Autoscan ───────────────────────────────────────────────────────
# Red propia/autorizada a escanear automaticamente (cada 10 min).
# Solo escanea este rango — no uses redes de terceros sin autorizacion.
NEXUS_SCAN_TARGET=192.168.1.0/24
