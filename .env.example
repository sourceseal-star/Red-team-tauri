# SourceSeal Console — Variables de entorno
# Copia este archivo a .env y completa los valores
#
# ⚠️ NUNCA commitear el .env real. Está en .gitignore.
# ⚠️ Si NEXUS_PASS, ADMIN_PASSWORD o REDTEAM_API_KEY faltan,
#    el backend las REGENERARÁ automáticamente al arrancar.
#    Esto te bloqueará el acceso. Mantén siempre estas variables.

# ─── CREDENCIALES CRÍTICAS (NUNCA dejar vacías) ──────────────────────────────
# Password para Nexus Omni-Sentient (:8004)
# Si falta, nexus_credentials.py genera una nueva y la escribe aquí
NEXUS_USER=admin
NEXUS_PASS=tu-password-seguro-aqui

# Password del administrador del Dashboard
# Si falta, ensure_managed_secret la regenera
ADMIN_PASSWORD=tu-password-admin-aqui

# API Key para acceder al servidor (Bearer token)
# Si falta, ensure_managed_secret la regenera
REDTEAM_API_KEY=genera-una-clave-aleatoria-aqui

# ─── SERVIDOR ────────────────────────────────────────────────────────────────
# Host binding (0.0.0.0 = todas las interfaces, acceso desde WiFi)
HOST=0.0.0.0
PORT=8001

# CORS origins permitidas (separadas por comas)
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Honeypot
HONEYPOT_PORT=8080

# ─── API KEYS OSINT (todas tienen tier gratis) ──────────────────────────────
# AbuseIPDB (gratis, 1000 checks/día): https://www.abuseipdb.com/account/api
# IMPORTANTE: usar ABUSEIPDB_KEY (no ABUSEIPDB_API_KEY)
ABUSEIPDB_KEY=

# Shodan (gratis, cuenta básica): https://www.shodan.io/dashboard
SHODAN_API_KEY=

# Hunter.io (opcional, emails): https://hunter.io/api-keys
HUNTER_API_KEY=

# VirusTotal (gratis, 4 req/min): https://www.virustotal.com/api
VIRUSTOTAL_API_KEY=

# Censys (gratis, 25 req/día): https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# Google Custom Search (gratis, 100 req/día): https://console.cloud.google.com
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# GitHub recon (gratis): https://github.com/settings/tokens (scope: read:user)
GITHUB_TOKEN=

# ─── SOL TELEGRAM BRIDGE ────────────────────────────────────────────────────
# Bot de Telegram que puentea el backend TACTICAL con el usuario
# Crea tu bot: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Tu Chat ID (obtenlo enviando un mensaje al bot, luego visita:
# https://api.telegram.org/bot<TU_TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=

# ─── SOL BRIDGE CONFIG ──────────────────────────────────────────────────────
# URL del backend TACTICAL (no cambiar en local)
BACKEND_URL=http://localhost:8001

# ─── SEAL IA (opcional) ─────────────────────────────────────────────────────
# 1 = activar orquestador de operaciones continuas
SEAL_ENABLED=0

# ─── TERMUX BRIDGE ───────────────────────────────────────────────────────────
TERMUX_API_URL=http://127.0.0.1:8000
