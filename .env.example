# SourceSeal Console — Variables de entorno
# Copia este archivo a .env y completa los valores

# API KEY obligatoria para acceder al servidor
REDTEAM_API_KEY=genera-una-clave-aleatoria-aqui

# Host binding (0.0.0.0 = todas las interfaces, acceso desde WiFi)
HOST=0.0.0.0
PORT=8001

# CORS origins permitidas (separadas por comas)
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Honeypot
HONEYPOT_PORT=8080

# ─── API KEYS OSINT (todas tienen tier gratis) ──────────────────────────────
# AbuseIPDB (gratis, 1000 checks/día): https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=

# Shodan (gratis, cuenta básica): https://www.shodan.io/dashboard
SHODAN_API_KEY=

# Hunter.io (opcional, emails): https://hunter.io/api-keys
HUNTER_API_KEY=

# ─── Termux Bridge ───────────────────────────────────────────────────────────
TERMUX_API_URL=http://127.0.0.1:8000
