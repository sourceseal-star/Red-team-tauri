# --- Página de Recuperación (TARGET CRÍTICO) ---
RECOVERY_PAGE=https://recuperacion.tu-dominio.com

# --- Notificaciones ---
SLACK_WEBHOOK=                         # https://hooks.slack.com/services/...
ALERT_WEBHOOK=                         # webhook genérico (Teams, Discord, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@tu-dominio.com
SMTP_PASS=
ALERT_FROM=redteam@tu-dominio.com
ALERT_TO=secops@tu-dominio.com,admin@tu-dominio.com

# --- TheHive ---
THEHIVE_URL=http://thehive.local:9000
THEHIVE_API_KEY=

# --- Honeypot ---
HONEYPOT_CANARY=hpt_change_me

# --- Tuning de ataques ---
A3_CONCURRENCY=10                      # threads para race condition
A4_BURST=100                           # requests para rate limit

# --- Identidad del agente ---
AGENT_ID=redteam-standalone-01
