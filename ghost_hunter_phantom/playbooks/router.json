{
  "name": "Router Recon",
  "description": "Reconocimiento de routers — puertos abiertos + fingerprinting de vendor",
  "target_type": "router",
  "steps": [
    {
      "name": "Búsqueda en Shodan / AlienVault OTX",
      "action": "shodan_search",
      "params": {
        "query": "port:22,80,443",
        "limit": 100
      }
    },
    {
      "name": "Geo Localización",
      "action": "geo_lookup",
      "params": {}
    },
    {
      "name": "Generar Reporte",
      "action": "report",
      "params": {
        "severity": "medium"
      }
    }
  ]
}
