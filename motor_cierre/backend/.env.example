# Motor de Cierre Autónomo v2.1 — Variables de entorno

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI (para NLP — si no está, usa heurística)
OPENAI_API_KEY=sk-...

# API Key del motor (Bearer token para todos los endpoints protegidos)
API_KEY=tu-clave-super-secreta-para-el-webhook

# Webhook secret para verificar webhooks del proveedor de email
WEBHOOK_SECRET=clave-para-firmar-webhooks-del-proveedor-de-email

# Base de datos SQLite (se crea automáticamente)
DB_PATH=./motor_cierre.db

# Configuración de checkout
DEFAULT_PRICE_USD=499
CHECKOUT_EXPIRY_MINUTES=30

# URLs de redirección por defecto (cada producto puede tener las suyas)
DEFAULT_SUCCESS_URL=https://sourceseal.com/success?session_id={CHECKOUT_SESSION_ID}
DEFAULT_CANCEL_URL=https://sourceseal.com/cancel

# CORS (separar con comas)
CORS_ORIGINS=*

# Puerto
PORT=8000
