## 📚 **RESUMEN Y USO**

### **Estructura Completa de Módulos**

```
leviathan_core/modules/
├── scanners/
│   ├── __init__.py
│   ├── rtsp_scanner.py          # Detección de RTSP
│   ├── onvif_scanner.py        # Detección de ONVIF
│   ├── http_fingerprint.py     # Fingerprinting HTTP
│   ├── network_scanner.py       # Escaneo de red
│   ├── camera_detector.py       # Detección de cámaras
│   └── service_scanner.py       # Escaneo de servicios
│
├── exploiters/
│   ├── __init__.py
│   ├── hikvision_rce.py         # Explotación Hikvision
│   ├── dahua_backdoor.py        # Explotación Dahua
│   ├── generic_brute.py         # Fuerza bruta genérica
│   ├── kraken_integration.py   # Integración con KRAKEN
│   └── exploit_chain.py         # Encadenamiento de exploits
│
├── ai_analyzers/
│   ├── __init__.py
│   ├── object_detection.py      # Detección de objetos con YOLOv8
│   ├── anomaly_detector.py      # Detección de anomalías
│   ├── behavior_analyzer.py     # Análisis de comportamiento
│   └── threat_scoring.py        # Puntuación de amenazas
│
└── reporters/
    ├── __init__.py
    ├── json_reporter.py          # Informes JSON
    ├── html_reporter.py          # Informes HTML
    └── pdf_reporter.py           # Informes PDF
```

### **Cómo Usar los Módulos**

#### **1. Cargar todos los módulos**

```python
from leviathan_core.modules.scanners import register_all as register_scanners
from leviathan_core.modules.exploiters import register_all as register_exploiters
from leviathan_core.modules.ai_analyzers import register_all as register_analyzers
from leviathan_core.modules.reporters import register_all as register_reporters

# Cargar todos los módulos
all_modules = []
all_modules.extend(register_scanners())
all_modules.extend(register_exploiters())
all_modules.extend(register_analyzers())
all_modules.extend(register_reporters())

print(f"✅ Módulos cargados: {len(all_modules)}")
```

#### **2. Usar un módulo específico**

```python
from leviathan_core.modules.scanners.camera_detector import CameraDetector

# Crear instancia
camera_detector = CameraDetector()

# Escanear una red
results = await camera_detector.scan("192.168.0.0/24")

print(f"Cámaras detectadas: {results['statistics']['total_detected']}")
for camera in results['cameras']:
    print(f"  - {camera['ip']}: {camera['vendor']} {camera['model']}")
```

#### **3. Usar un exploiter**

```python
from leviathan_core.modules.exploiters.hikvision_rce import HikvisionRCEExploiter

# Crear instancia
exploiter = HikvisionRCEExploiter()

# Explotar una cámara Hikvision
context = {
    "vendor": "hikvision",
    "model": "DS-2CD2043G2-IU"
}

results = await exploiter.exploit("192.168.0.7", context)

if results['success']:
    print("✅ Explotación exitosa!")
    for exploit in results['exploits_tried']:
        if exploit['success']:
            print(f"  - {exploit['exploit_name']}: {exploit.get('proof_of_concept', '')}")
```

#### **4. Usar un analizador de IA**

```python
from leviathan_core.modules.ai_analyzers.threat_scoring import ThreatScoringAnalyzer

# Crear instancia
analyzer = ThreatScoringAnalyzer()

# Analizar amenaza
context = {
    "vulnerabilities": [
        {"severity": "critical", "cve_id": "CVE-2021-36260"},
        {"severity": "high", "cve_id": "CVE-2021-31956"}
    ],
    "exploits_available": 5,
    "exploits_successful": 2,
    "is_accessible": True,
    "open_ports": 10,
    "device_type": "camera",
    "has_sensitive_data": True,
    "anomalies": [
        {"severity": "high", "type": "port_scan"},
        {"severity": "critical", "type": "brute_force"}
    ]
}

results = await analyzer.analyze("192.168.0.7", context)

print(f"Puntuación de amenaza: {results['score']:.1f}")
print(f"Nivel de riesgo: {results['risk_level'].upper()}")
print("\nRecomendaciones:")
for rec in results['recommendations']:
    print(f"  - {rec}")
```

#### **5. Generar un informe**

```python
from leviathan_core.modules.reporters.html_reporter import HTMLReporter

# Crear instancia
reporter = HTMLReporter()

# Generar informe
context = {
    "scan_type": "comprehensive",
    "summary": {
        "total_targets": 254,
        "active_targets": 50,
        "cameras_detected": 3,
        "vulnerabilities_found": 15,
        "threat_score": 85.5,
        "threat_level": "high"
    },
    "findings": {
        "cameras": [
            {
                "ip": "192.168.0.7",
                "vendor": "Hikvision",
                "model": "DS-2CD2043G2-IU",
                "port": 80,
                "is_accessible": True,
                "credentials": "admin:12345"
            }
        ],
        "vulnerabilities": [
            {
                "cve_id": "CVE-2021-36260",
                "severity": "critical",
                "title": "Hikvision Authentication Bypass",
                "cvss_score": 9.8
            }
        ]
    },
    "recommendations": [
        "🟠 ALTO RIESGO: Revisar y parchear inmediatamente",
        "Aplicar parches de seguridad para todas las vulnerabilidades críticas"
    ]
}

results = await reporter.generate("192.168.0.0/24", context)

print(f"✅ Informe HTML generado: {results['file_path']}")
```

