run = "bash replit_start.sh"
modules = ["python-3.12", "nodejs-20", "bash"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "replit_start.sh"]

[[ports]]
localPort = 5000
externalPort = 3000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8080

[[ports]]
localPort = 8001
externalPort = 80

[[ports]]
localPort = 8002
externalPort = 3002

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SourceSeal Dashboard"

[[workflows.workflow]]
name = "SourceSeal Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash replit_start.sh"
waitForPort = 8001

[rules]

[rules.formatter]

[rules.formatter.fileExtensions]

[rules.formatter.fileExtensions.".json"]
id = "module:nodejs-20/languageServer:typescript-language-server"
