run = "bash replit_start.sh"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "replit_start.sh"]

# Puerto 5000 → interfaz web principal (React frontend)
[[ports]]
localPort = 5000
externalPort = 80

# Puerto 8001 → backend Python (interno, no expuesto)
[[ports]]
localPort = 8001
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash replit_start.sh"
