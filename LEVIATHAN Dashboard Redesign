@router.post("/exploit/camera", summary="Explotación de Cámara")
async def exploit_camera(
    target: str,
    vendor: Optional[str] = None,
    model: Optional[str] = None,
    exploit_type: str = "auto",
    use_kraken: bool = False
) -> Dict:
    """
    Explotación de vulnerabilidades en cámaras IP.
    
    **Parámetros:**
    - target: IP o hostname de la cámara
    - vendor: Vendor (hikvision, dahua, axis, etc.)
    - model: Modelo de la cámara
    - exploit_type: Tipo de exploit (auto, hikvision_rce, dahua_backdoor, generic_brute)
    - use_kraken: Usar KRAKEN para explotación avanzada
    """
    try:
        from leviathan_core.modules.exploiters.hikvision_rce import HikvisionRCEExploiter
        from leviathan_core.modules.exploiters.dahua_backdoor import DahuaBackdoorExploiter
        from leviathan_core.modules.exploiters.generic_brute import GenericBruteExploiter
        from leviathan_core.modules.exploiters.kraken_integration import KRAKENExploiter
        from leviathan_core.modules.exploiters.exploit_chain import ExploitChainExploiter
        
        context = {
            "vendor": vendor,
            "model": model
        }
        
        # Si no se especifica vendor, detectar primero
        if vendor is None or exploit_type == "auto":
            from leviathan_core.modules.scanners.camera_detector import CameraDetector
            detector = CameraDetector()
            camera_result = await detector.scan(target)
            if camera_result.get("cameras"):
                camera = camera_result["cameras"][0]
                context.update(camera)
                vendor = camera.get("vendor", "").lower()
                model = camera.get("model", "")
        
        # Seleccionar exploiter
        if use_kraken:
            exploiter = KRAKENExploiter()
            result = await exploiter.exploit(target, context)
        elif vendor == "hikvision":
            exploiter = HikvisionRCEExploiter()
            result = await exploiter.exploit(target, context)
        elif vendor == "dahua":
            exploiter = DahuaBackdoorExploiter()
            result = await exploiter.exploit(target, context)
        else:
            exploiter = GenericBruteExploiter()
            result = await exploiter.exploit(target, context)
        
        return {
            "success": True,
            "target": target,
            "vendor": vendor,
            "model": model,
            "results": result,
            "timestamp": datetime.utcnow().isoformat()
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error en explotación: {str(e)}")


