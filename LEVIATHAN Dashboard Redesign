import { useState, useEffect, useRef, useCallback } from 'react';

/**
 * Hook personalizado para manejar conexiones WebSocket
 * @param {string} url - URL del servidor WebSocket
 * @param {Object} options - Opciones de configuración
 * @returns {Object} Objeto con estado y funciones de WebSocket
 */
export const useWebSocket = (url = null, options = {}) => {
  const {
    onOpen,
    onClose,
    onError,
    onMessage,
    onAlert,
    reconnectInterval = 5000,
    maxReconnectAttempts = 10
  } = options;

  const [socket, setSocket] = useState(null);
  const [isConnected, setIsConnected] = useState(false);
  const [isConnecting, setIsConnecting] = useState(false);
  const [reconnectAttempts, setReconnectAttempts] = useState(0);
  const [lastMessage, setLastMessage] = useState(null);
  const [lastError, setLastError] = useState(null);

  const socketRef = useRef(null);
  const reconnectTimeoutRef = useRef(null);
  const messageQueueRef = useRef([]);

  // URL por defecto
  const defaultUrl = url || `ws://${window.location.hostname}:8000/ws`;

  /**
   * Conectar al servidor WebSocket
   */
  const connect = useCallback(() => {
    // Limpiar timeout de reconexión
    if (reconnectTimeoutRef.current) {
      clearTimeout(reconnectTimeoutRef.current);
      reconnectTimeoutRef.current = null;
    }

    // Cerrar conexión existente
    if (socketRef.current) {
      socketRef.current.close();
    }

    setIsConnecting(true);
    setLastError(null);

    try {
      const newSocket = new WebSocket(defaultUrl);
      socketRef.current = newSocket;
      setSocket(newSocket);

      newSocket.onopen = () => {
        setIsConnected(true);
        setIsConnecting(false);
        setReconnectAttempts(0);
        
        // Procesar mensajes en cola
        while (messageQueueRef.current.length > 0) {
          const message = messageQueueRef.current.shift();
          newSocket.send(JSON.stringify(message));
        }

        if (onOpen) onOpen();
      };

      newSocket.onclose = (event) => {
        setIsConnected(false);
        setIsConnecting(false);
        
        if (onClose) onClose(event);

        // Intentar reconectar
        if (reconnectAttempts < maxReconnectAttempts) {
          const delay = reconnectInterval * Math.pow(1.5, reconnectAttempts);
          reconnectTimeoutRef.current = setTimeout(() => {
            setReconnectAttempts(prev => prev + 1);
            connect();
          }, delay);
        }
      };

      newSocket.onerror = (error) => {
        setIsConnecting(false);
        setLastError(error);
        
        if (onError) onError(error);
      };

      newSocket.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          setLastMessage(data);
          
          if (onMessage) onMessage(data);

          // Manejar alertas específicas
          if (data.type === 'alert' && onAlert) {
            onAlert(data.data);
          }
        } catch (error) {
          console.error('Error parsing WebSocket message:', error);
        }
      };

    } catch (error) {
      setIsConnecting(false);
      setLastError(error);
      console.error('WebSocket connection error:', error);
    }
  }, [defaultUrl, onOpen, onClose, onError, onMessage, onAlert, reconnectInterval, maxReconnectAttempts, reconnectAttempts]);

  /**
   * Desconectar del servidor WebSocket
   */
  const disconnect = useCallback(() => {
    if (reconnectTimeoutRef.current) {
      clearTimeout(reconnectTimeoutRef.current);
      reconnectTimeoutRef.current = null;
    }

    if (socketRef.current) {
      socketRef.current.close();
      socketRef.current = null;
    }

    setIsConnected(false);
    setIsConnecting(false);
    setSocket(null);
  }, []);

  /**
   * Enviar mensaje
   * @param {Object} message - Mensaje a enviar
   */
  const sendMessage = useCallback((message) => {
    if (socketRef.current && socketRef.current.readyState === WebSocket.OPEN) {
      socketRef.current.send(JSON.stringify(message));
    } else {
      // Agregar a cola si no está conectado
      messageQueueRef.current.push(message);
    }
  }, []);

  /**
   * Suscribirse a un canal
   * @param {string} channel - Canal a suscribirse
   */
  const subscribe = useCallback((channel) => {
    sendMessage({
      type: 'subscribe',
      channel: channel
    });
  }, [sendMessage]);

  /**
   * Desuscribirse de un canal
   * @param {string} channel - Canal a desuscribirse
   */
  const unsubscribe = useCallback((channel) => {
    sendMessage({
      type: 'unsubscribe',
      channel: channel
    });
  }, [sendMessage]);

  // Limpiar al desmontar
  useEffect(() => {
    return () => {
      disconnect();
    };
  }, [disconnect]);

  return {
    socket,
    isConnected,
    isConnecting,
    reconnectAttempts,
    lastMessage,
    lastError,
    connect,
    disconnect,
    sendMessage,
    subscribe,
    unsubscribe
  };
};

/**
 * Proveedor de contexto WebSocket
 */
export const WebSocketProvider = ({ children }) => {
  const wsState = useWebSocket();
  return children(wsState);
};

export default useWebSocket;
