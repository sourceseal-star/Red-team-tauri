          break;
        case 'chain':
          result = await exploitChain(target, ['hikvision_rce', 'dahua_backdoor', 'generic_brute']);
          break;
        default:
          result = await krakenExploit(target, method.id);
      }

      setResults(Array.isArray(result) ? result : [result]);
      setExploitProgress(100);
      clearInterval(progressInterval);

      // Llamar callback si existe
      if (onExploitComplete) {
        onExploitComplete(result);
      }
    } catch (err) {
      console.error('Error during exploitation:', err);
      setResults([{ error: err.error || 'Error en la explotación' }]);
    } finally {
      setIsExploiting(false);
      setTimeout(() => setSelectedMethod(null), 2000);
    }
  }, [target, exploitCamera, krakenExploit, exploitChain, onExploitComplete, clearError]);

  // Obtener color de estado
  const getStatusColor = (status) => {
