@router.post("/report/generate", summary="Generar Informe")
async def generate_report(
    report_type: str = "json",
    target: str = "scan",
    data: Optional[Dict] = None
) -> Dict:
    """
    Generar informe en el formato especificado.
    
    **Parámetros:**
    - report_type: Tipo de informe (json, html, pdf)
    - target: Objetivo del informe
    - data: Datos para el informe
    """
    try:
        from leviathan_core.modules.reporters.json_reporter import JSONReporter
        from leviathan_core.modules.reporters.html_reporter import HTMLReporter
        from leviathan_core.modules.reporters.pdf_reporter import PDFReporter
        
        if report_type == "json":
            reporter = JSONReporter()
        elif report_type == "html":
            reporter = HTMLReporter()
        elif report_type == "pdf":
            reporter = PDFReporter()
        else:
            return {"success": False, "error": "Tipo de informe no válido"}
        
        result = await reporter.generate(target, data or {})
        
        if result.get("success"):
            if report_type == "html" and result.get("file_path"):
                return FileResponse(
                    result["file_path"],
                    media_type="text/html",
                    filename=f"leviathan_{target}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.html"
                )
            elif report_type == "pdf" and result.get("file_path"):
                return FileResponse(
                    result["file_path"],
                    media_type="application/pdf",
                    filename=f"leviathan_{target}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf"
                )
            else:
                return {"success": True, "data": result}
        else:
            return {"success": False, "error": result.get("error")}
            
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error en informe: {str(e)}")


