@router.post("/scan/network", summary="Escaneo de Red Completo")
async def scan_network(
    network: str = "192.168.0.0/24",
    profile: str = "camera_detection",
    deep: bool = False,
    timeout: int = 5
) -> Dict:
    """
    Escaneo completo de red con detección de cámaras.
    
    **Parámetros:**
    - network: Red a escanear (ej: 192.168.0.0/24)
    - profile: Perfil de escaneo (stealth, aggressive, massive, camera_detection)
    - deep: Escaneo profundo (más lento pero más preciso)
    - timeout: Timeout en segundos por host
    
    **Retorna:**
    - devices: Dispositivos detectados
    - cameras: Cámaras IP detectadas
    - statistics: Estadísticas del escaneo
    """
    try:
        from leviathan_core.modules.scanners.network_scanner import NetworkScanner
        from leviathan_core.modules.scanners.camera_detector import CameraDetector
        
        # Escanear red
        scanner = NetworkScanner()
        scan_result = await scanner.scan(network, {
            "profile": profile,
            "deep": deep,
            "timeout": timeout
        })
        
        # Detectar cámaras
        detector = CameraDetector()
        camera_result = await detector.scan(network, {
            "ports": [80, 443, 554, 8000, 8080, 37777, 3702]
        })
        
        return {
            "success": True,
            "network": network,
            "devices": scan_result.get("devices", []),
            "cameras": camera_result.get("cameras", []),
            "statistics": {
                "total_devices": scan_result.get("statistics", {}).get("active_ips", 0),
                "total_cameras": camera_result.get("statistics", {}).get("total_detected", 0),
                "accessible_cameras": camera_result.get("statistics", {}).get("accessible", 0),
                "vulnerable_cameras": camera_result.get("statistics", {}).get("vulnerable", 0)
            },
            "timestamp": datetime.utcnow().isoformat()
        }
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error en escaneo: {str(e)}")


