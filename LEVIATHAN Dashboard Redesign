@router.post("/ai/detect-objects", summary="Detección de Objetos con IA")
async def detect_objects(
    image_data: Optional[str] = None,
    image_path: Optional[str] = None,
    stream_url: Optional[str] = None,
    confidence_threshold: float = 0.5
) -> Dict:
    """
    Detección de objetos en imágenes usando YOLOv8.
    
    **Parámetros:**
    - image_data: Imagen en base64
    - image_path: Ruta a archivo de imagen
    - stream_url: URL de stream de video
    - confidence_threshold: Umbral de confianza (0-1)
    """
    try:
        from leviathan_core.modules.ai_analyzers.object_detection import ObjectDetectionAnalyzer
        
        analyzer = ObjectDetectionAnalyzer()
        await analyzer.initialize()
        
        context = {
            "image_data": image_data,
            "image_path": image_path,
            "stream_url": stream_url,
            "confidence_threshold": confidence_threshold
        }
        
        result = await analyzer.analyze("camera", context)
        
        return {
            "success": True,
            "detections": result.get("detections", []),
            "statistics": result.get("statistics", {}),
            "timestamp": datetime.utcnow().isoformat()
        }
        
    except Exception as e:
        # Degradar gracefully si YOLOv8 no está disponible
        return {
            "success": False,
            "error": f"YOLOv8 no disponible: {str(e)}",
            "suggestion": "Instala ultralytics: pip install ultralytics",
            "timestamp": datetime.utcnow().isoformat()
        }


