{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "/dashboard/index.html" },
    { "src": "/dashboard", "dest": "/dashboard/index.html" },
    { "src": "/dashboard/(.*)", "dest": "/dashboard/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/manifest.json", "dest": "/dashboard/manifest.json" },
    { "src": "/sw.js", "dest": "/dashboard/sw.js" }
  ],
  "env": {
    "SOURCESEAL_API": "@sourceseal-api",
    "SOURCESEAL_KEY": "@sourceseal-key"
  }
}
