    "body": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1\" />\n  <meta name=\"theme-color\" content=\"#0b0e11\" />\n  <link rel=\"manifest\" href=\"manifest.json\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"assets/favicon.svg\" />\n  <link rel=\"apple-touch-icon\" href=\"assets/icon-192.png\" />\n  <title>SOURCESEAL — Centro de Control</title>\n  <link rel=\"stylesheet\" href=\"assets/styles.css\" />\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"brand\">\n      <span class=\"logo\">🛡️</span>\n      <div>\n        <h1>SOURCESEAL <span class=\"accent\">Centro de Control</span></h1>\n        <small id=\"agent-id\" class=\"muted\">redteam + site monitor + editor</small>\n      </div>\n    </div>\n    <div class=\"status\">\n      <span id=\"status-dot\" class=\"dot off\"></span>\n      <span id=\"status-text\">desconectado</span>\n      <button id=\"refresh-btn\" class=\"btn ghost\" title=\"Refrescar\">↻</button>\n    </div>\n  </header>\n\n  <nav class=\"tabs\">\n    <button class=\"tab active\" data-tab=\"agent\">🛡 Red Team Agent</button>\n    <button class=\"tab\" data-tab=\"monitor\">🛰 Monitor del Sitio</button>\n    <button class=\"tab\" data-tab=\"editor\">✏ Editor Frontend</button>\n  </nav>\n\n  <!-- ============================================================ TAB 1 -->\n  <main class=\"tab-pane active\" id=\"tab-agent\">\n    <section class=\"kpis\">\n      <div class=\"kpi critical\"><div class=\"kpi-label\">Críticos</div><div class=\"kpi-value\" id=\"kpi-critical\">0</div></div>\n      <div class=\"kpi high\"><div class=\"kpi-label\">Altos</div><div class=\"kpi-value\" id=\"kpi-high\">0</div></div>\n      <div class=\"kpi medium\"><div class=\"kpi-label\">Medios</div><div class=\"kpi-value\" id=\"kpi-medium\">0</div></div>\n      <div class=\"kpi low\"><div class=\"kpi-label\">Bajos / Info</div><div class=\"kpi-value\" id=\"kpi-low\">0</div></div>\n      <div class=\"kpi total\"><div class=\"kpi-label\">Total hallazgos</div><div class=\"kpi-value\" id=\"kpi-total\">0</div>\n        <div class=\"muted small\">último scan: <span id=\"last-scan\">—</span></div></div>\n    </section>\n    <section class=\"grid\">\n      <div class=\"card\">\n        <div class=\"card-header\"><h2>Hallazgos</h2>\n          <input type=\"text\" id=\"filter\" class=\"search\" placeholder=\"🔎 buscar…\" /></div>\n        <div class=\"table-wrap\">\n          <table id=\"findings-table\">\n            <thead><tr><th>#</th><th>Severidad</th><th>Escenario</th><th>Título</th><th>Detectado</th></tr></thead>\n            <tbody id=\"findings-body\"><tr><td colspan=\"5\" class=\"empty\">Cargando...</td></tr></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"card actions\">\n        <h2>Acciones</h2>\n        <button id=\"run-scan\" class=\"btn primary\">▶ Ejecutar escaneo</button>\n        <button id=\"download-report\" class=\"btn\">⬇ Descargar último reporte</button>\n        <div id=\"action-status\" class=\"muted small\"></div>\n      </div>\n    </section>\n  </main>\n\n  <!-- =============================================="
  },
