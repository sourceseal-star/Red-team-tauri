    width: '10px',
    height: '10px',
    borderRadius: '50%',
    backgroundColor: color
  }),
  tabs: {
    display: 'flex',
    gap: '5px',
    marginBottom: '20px',
    backgroundColor: '#1e293b',
    padding: '5px',
    borderRadius: '8px'
  },
  tab: (isActive: boolean) => ({
    flex: 1,
    padding: '12px 20px',
    border: 'none',
    backgroundColor: isActive ? '#3b82f6' : 'transparent',
    color: isActive ? '#fff' : '#94a3b8',
    borderRadius: '6px',
    cursor: 'pointer',
    fontSize: '14px',
    fontWeight: '500',
    transition: 'all 0.2s ease'
  }),
  content: {
    padding: '10px'
  },
  card: {
    backgroundColor: '#1e293b',
