    fontSize: '14px',
    color: '#94a3b8',
    marginTop: '5px'
  },
  statusIndicator: {
    display: 'flex',
    alignItems: 'center',
    gap: '10px',
    padding: '8px 16px',
    borderRadius: '20px',
    backgroundColor: '#1e293b',
    fontSize: '14px'
  },
